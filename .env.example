# ==============================================================================
# RISK // INDIA — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure for your local or production environment.
# NEVER commit real credentials, production secrets, or private keys to git.
# ==============================================================================

# Application Environment
APP_NAME=risk-india-api
APP_ENV=development
DEBUG=true
PORT=8000
WEB_CONCURRENCY=4
LOG_LEVEL=INFO

# Container Orchestration (Docker Compose)
FRONTEND_PORT=80
POSTGRES_USER=risk_user
POSTGRES_PASSWORD=risk_password_change_me
POSTGRES_DB=risk_india


# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Development (Default):
DATABASE_URL=sqlite:///./risk_india.db

# Production (PostgreSQL 16 via psycopg):
# Format: postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
# Example: DATABASE_URL=postgresql+psycopg://risk_admin:CHANGE_ME_IN_PRODUCTION@postgres.internal.cluster:5432/risk_india

# Connection Pool (Applies to PostgreSQL in production)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# Cache & Feed Storage (Graceful In-Memory Fallback)
# ------------------------------------------------------------------------------
# Development (Default in-memory TTL cache):
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=300

# Production Redis (Optional):
# REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis.internal.cluster:6379/0
# CACHE_BACKEND=redis

# ------------------------------------------------------------------------------
# Security, CORS & Abuse Controls
# ------------------------------------------------------------------------------
# Allowed Origin Whitelist (Comma-separated, wildcard '*' strictly disallowed with credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Strict Transport Security (Enabled automatically in production or HTTPS)
ENABLE_HSTS=false

# Sliding-Window Rate Limiting (Requests / 60 seconds)
RATE_LIMIT_GENERAL=60
RATE_LIMIT_COMPUTE=10
