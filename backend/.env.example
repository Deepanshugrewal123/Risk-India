# RISK // INDIA Backend Environment Configuration

# Application
APP_NAME=risk-india-api
APP_ENV=development
DEBUG=True
PORT=8000

# Database
# Default to SQLite for local development; switch to PostgreSQL when ready:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/risk_india
DATABASE_URL=sqlite:///./risk_india.db

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
