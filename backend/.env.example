# ==============================================================================
# RISK // INDIA — Backend Environment Configuration Template (backend/.env.example)
# ==============================================================================
# Copy this file to backend/.env for standalone backend development.
# NEVER commit credentials or secrets to version control.
# ==============================================================================

APP_NAME=risk-india-api
APP_ENV=development
DEBUG=true
PORT=8000
WEB_CONCURRENCY=4
LOG_LEVEL=INFO

# Database Configuration
# Local SQLite (Development)
DATABASE_URL=sqlite:///./risk_india.db

# Production PostgreSQL (Uncomment and configure for production):
# DATABASE_URL=postgresql+psycopg2://risk_user:risk_password@localhost:5432/risk_india

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Cache Configuration
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=300

# Redis Cache (Optional production distributed cache)
# REDIS_URL=redis://localhost:6379/0
# CACHE_BACKEND=redis

# CORS Origins (Comma-separated, no wildcards when credentials enabled)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Security Controls
ENABLE_HSTS=false
RATE_LIMIT_GENERAL=60
RATE_LIMIT_COMPUTE=10
